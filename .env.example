# Caminho gratuito e local, sem chave. Extrai evidências, não é um LLM generativo.
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_FALLBACKS=
# Exemplo de fallback opt-in: gemini,ollama,extractive
LLM_TIMEOUT=45
LLM_MAX_OUTPUT_TOKENS=2048

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_ONLY=true

# Preencha um ID disponível com free tier na sua conta AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI é opcional e pode ter custo. Nenhum modelo é escolhido automaticamente.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# chat_completions para compatíveis; responses para modelos que exigem Responses.
OPENAI_API_MODE=chat_completions

# Ollama instalado separadamente; escolha um modelo local já baixado.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./models
EMBEDDING_OFFLINE=false
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=soc_logs
DATA_DIR=./data
CHUNK_TOKENS=96
CHUNK_OVERLAP=16
TOP_K=5
VECTOR_WEIGHT=0.5
AGENT_ENABLED=false
AGENT_MAX_ROUNDS=3
LOG_LEVEL=INFO
